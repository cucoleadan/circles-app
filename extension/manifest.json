{
  "manifest_version": 3,
  "name": "Circles Companion",
  "version": "0.2.6",
  "description": "Connects your Substack session to Circles CRM and adds people to your lists.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://*.substack.com/*",
    "https://circles.mhntwrkdan.dev/*",
    "http://localhost:4321/*",
    "http://127.0.0.1:4321/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.substack.com/*"],
      "js": ["page-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.substack.com/*"],
      "js": ["activity-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://circles.mhntwrkdan.dev/*",
        "http://localhost:4321/*",
        "http://127.0.0.1:4321/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.substack.com/*"],
      "js": ["substack.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://circles.mhntwrkdan.dev/*",
      "http://localhost:4321/*",
      "http://127.0.0.1:4321/*"
    ]
  }
}
