APP_URL=https://circles.example.com
DATABASE_URL=postgresql://user:password@circles-postgres:5432/circles_crm
APP_DB_PASSWORD=replace-with-random-password-for-the-circles_app-role
MIGRATE_DB_PASSWORD=replace-with-random-password-for-the-circles_migrate-role

# Dedicated runtime connection (limited circles_app role) used by api/worker.
APP_DATABASE_URL=postgresql://circles_app:password@circles-postgres:5432/circles_crm
DATABASE_POOL_SIZE=5

BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
ALLOW_SIGNUP=false

# Encrypts stored Substack sessions (api and worker). Generate with: openssl rand -base64 32
# Keep it stable and backed up: rotating or losing it makes stored sessions unreadable.
SESSION_TOKEN_KEY=

# Web service: where the Astro server reaches the API on the Docker network.
API_INTERNAL_URL=http://api:3000
# Optional: your own Chrome Web Store listing instead of the public Circles Companion.
EXTENSION_STORE_URL=
# Optional contact address shown on /privacy.
CONTACT_EMAIL=

# Optional browser MCP client origins, comma-separated. Gateway server calls need none.
MCP_ALLOWED_ORIGINS=
# Default timezone for the MCP day brief (IANA name, e.g. Europe/Bucharest).
TZ=UTC
# Optional Cloudflare Access OIDC login; configure all three and explicitly link an existing account.
CLOUDFLARE_ACCESS_DISCOVERY_URL=
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Local development only (scripts/dev.ts): reach a remote database over SSH
# instead of using DATABASE_URL directly.
CIRCLES_SSH_HOST=
CIRCLES_SSH_DB_ENV_FILE=
