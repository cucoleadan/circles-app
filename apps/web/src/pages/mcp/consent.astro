---
import "@workspace/ui/globals.css"
const apiUrl = process.env.API_INTERNAL_URL ?? "http://localhost:3000"
const oauthQuery = Astro.url.search.slice(1)
const response = await fetch(`${apiUrl}/api/mcp/consent?oauth_query=${encodeURIComponent(oauthQuery)}`, {
  headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
})
if (response.status === 401) return Astro.redirect(`/login${Astro.url.search}`)
const details = response.ok ? await response.json() as {
  name: string; clientId: string; email: string; permissions: Array<{ scope: string; description: string }>
} : null
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Authorize an agent · Circles</title></head>
  <body class="bg-background text-foreground">
    <main class="mx-auto max-w-xl space-y-5 px-6 py-16">
      <h1 class="text-2xl font-semibold">Connect an agent to Circles</h1>
      {details ? <>
        <p><strong>{details.name}</strong> requests access to {details.email}.</p>
        <p class="break-all text-sm text-muted-foreground">Client: {details.clientId}</p>
        <p>Choose the permissions to grant:</p>
        <form id="consent" class="space-y-4">
          {details.permissions.map(({ scope, description }) => <label class="flex gap-3 rounded-lg border p-3">
            <input type="checkbox" name="scope" value={scope} checked={scope.endsWith(":read") || scope === "offline_access"} />
            <span>{description}</span>
          </label>)}
          <div class="flex gap-3">
            <button class="rounded-md bg-primary px-4 py-2 text-primary-foreground" type="submit">Allow selected permissions</button>
            <button class="rounded-md border px-4 py-2" id="deny" type="button">Deny</button>
          </div>
          <p class="text-sm text-muted-foreground">You can revoke this connection from Connected agents.</p>
        </form>
      </> : <p role="alert">This authorization request is invalid or expired. Connect again from your MCP client.</p>}
      <p id="status" role="status"></p>
    </main>
    <script>
      const form = document.querySelector<HTMLFormElement>("#consent")
      const status = document.querySelector("#status")
      async function consent(accept: boolean) {
        if (!form || !status) return
        const scope = new FormData(form).getAll("scope").join(" ")
        if (accept && !scope) { status.textContent = "Select at least one permission or choose Deny."; return }
        const response = await fetch("/api/auth/oauth2/consent", {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ accept, ...(accept && { scope }), oauth_query: location.search.slice(1) }),
        })
        const data = await response.json().catch(() => null)
        if (response.ok && typeof data?.url === "string") location.assign(data.url)
        else status.textContent = "Authorization could not be completed. Reconnect from your MCP client."
      }
      form?.addEventListener("submit", (event) => { event.preventDefault(); void consent(true) })
      document.querySelector("#deny")?.addEventListener("click", () => void consent(false))
    </script>
  </body>
</html>
