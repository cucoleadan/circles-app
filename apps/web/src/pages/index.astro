---
import "@workspace/ui/globals.css"

type Contact = { id: string; name: string; handle: string | null; notes: string | null }
const apiUrl = process.env.API_INTERNAL_URL ?? "http://localhost:3000"
const response = await fetch(`${apiUrl}/api/contacts`, {
  headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
})
if (response.status === 401) return Astro.redirect("/login")
if (!response.ok) throw new Error("The API is unavailable")
const { contacts } = (await response.json()) as { contacts: Contact[] }
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Circles</title>
  </head>
  <body class="bg-background text-foreground">
    <main class="mx-auto min-h-screen max-w-4xl px-6 py-12">
      <header class="mb-10 flex items-center justify-between">
        <div><p class="text-sm text-muted-foreground">CRM</p><h1 class="text-3xl font-semibold tracking-tight">Circles</h1></div>
        <button id="logout" class="rounded-md border px-3 py-2 text-sm">Sign out</button>
      </header>

      <section class="mb-10 rounded-xl border p-5">
        <h2 class="mb-4 font-medium">Add contact</h2>
        <form id="contact-form" class="grid gap-3 sm:grid-cols-2">
          <input class="rounded-md border bg-transparent px-3 py-2" name="name" placeholder="Name" required maxlength="120" />
          <input class="rounded-md border bg-transparent px-3 py-2" name="handle" placeholder="Substack handle" maxlength="120" />
          <textarea class="rounded-md border bg-transparent px-3 py-2 sm:col-span-2" name="notes" placeholder="Private notes" maxlength="5000"></textarea>
          <div class="flex items-center gap-3 sm:col-span-2">
            <button class="rounded-md bg-primary px-4 py-2 text-primary-foreground" type="submit">Save contact</button>
            <span id="form-status" class="text-sm text-muted-foreground"></span>
          </div>
        </form>
      </section>

      <section>
        <h2 class="mb-4 font-medium">Contacts ({contacts.length})</h2>
        <div class="grid gap-3">
          {contacts.length === 0 && <p class="text-sm text-muted-foreground">No contacts yet.</p>}
          {contacts.map((contact) => (
            <article class="rounded-xl border p-4">
              <h3 class="font-medium">{contact.name}</h3>
              {contact.handle && <p class="text-sm text-muted-foreground">@{contact.handle}</p>}
              {contact.notes && <p class="mt-3 text-sm">{contact.notes}</p>}
            </article>
          ))}
        </div>
      </section>
    </main>

    <script>
      const form = document.querySelector<HTMLFormElement>("#contact-form")!
      const status = document.querySelector<HTMLSpanElement>("#form-status")!
      form.addEventListener("submit", async (event) => {
        event.preventDefault()
        status.textContent = "Saving…"
        const response = await fetch("/api/contacts", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        })
        if (response.ok) location.reload()
        else status.textContent = "Could not save contact."
      })
      document.querySelector("#logout")!.addEventListener("click", async () => {
        await fetch("/api/auth/sign-out", { method: "POST" })
        location.href = "/login"
      })
    </script>
  </body>
</html>
