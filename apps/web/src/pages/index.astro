---
import "@workspace/ui/globals.css"
import { CirclesWorkspace, type Contact } from "../components/circles-workspace"

const apiUrl = process.env.API_INTERNAL_URL ?? "http://localhost:3000"
const response = await fetch(`${apiUrl}/api/contacts`, {
  headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
})

if (response.status === 401) return Astro.redirect("/login")
if (!response.ok) throw new Error("The API is unavailable")

const { contacts } = (await response.json()) as { contacts: Contact[] }
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A calm CRM for the relationships that matter."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Circles CRM</title>
  </head>
  <body>
    <CirclesWorkspace initialContacts={contacts} client:load />
  </body>
</html>
